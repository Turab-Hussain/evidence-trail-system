# Copy to .env and export, or pass to Docker with --env-file.
EVIDENCE_DB_PATH=evidence_trail.db
# Signs login tokens. Optional: if empty, a random key is generated once and kept in the
# database, so users stay signed in across restarts. Set it yourself in production.
EVIDENCE_SECRET_KEY=
# How long a login lasts, in hours (default 168 = 7 days).
EVIDENCE_TOKEN_TTL_HOURS=168
# "none" = offline heuristics, "gemini" = Gemini extraction (pip install -e ".[gemini]"),
# "anthropic" = Claude extraction (pip install -e ".[anthropic]")
EVIDENCE_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional; defaults to gemini-flash-latest. Set a specific model your key can use.
EVIDENCE_LLM_MODEL=
ANTHROPIC_API_KEY=
EVIDENCE_SIMILARITY_THRESHOLD=0.4

# Browser origins allowed to call the API (comma-separated). Add your deployed frontend URL.
EVIDENCE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
